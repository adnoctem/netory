load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "server",
    srcs = [
        "admin.go",
        "aggregate.go",
        "coalesce.go",
        "concurrency.go",
        "forward.go",
        "proxy.go",
        "server.go",
    ],
    importpath = "github.com/adnoctem/netory/internal/pivot/server",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/pivot/app",
        "//internal/pivot/auth",
        "//internal/pivot/cache",
        "//internal/pivot/rules",
        "//pkg/admin",
        "//pkg/event",
        "//pkg/forwarded",
        "//pkg/log",
        "//pkg/notify",
    ],
)

alias(
    name = "go_default_library",
    actual = ":server",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "server_test",
    srcs = [
        "limits_test.go",
        "proxy_test.go",
    ],
    deps = [
        ":server",
        "//internal/pivot/app",
        "//internal/pivot/auth",
        "//internal/pivot/config",
        "//internal/pivot/rules",
        "//pkg/kv/valkeykv",
        "//pkg/log",
        "//pkg/secret",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
