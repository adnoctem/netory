load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")
load("//scripts/bazel:image.bzl", "netory_image")

go_library(
    name = "pivot_lib",
    srcs = ["main.go"],
    importpath = "github.com/adnoctem/netory/cmd/pivot",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/pivot/cmd",
        "//pkg/admin",
        "//pkg/stamp",
    ],
)

go_binary(
    name = "pivot",
    embed = [":pivot_lib"],

    # Static, so the binary runs in an image carrying no libc. The release
    # configuration sets this globally; stating it here means the image is
    # static whichever configuration built it.
    pure = "on",
    visibility = ["//visibility:public"],
)

netory_image(
    binary = ":pivot",
    description = "Transparent API proxy: filters, authenticates and rate-limits customer traffic to a production API",
    exposed_ports = [
        "8443/tcp",
    ],
    service = "pivot",
    state_dirs = [
        "/run/pivot",
    ],
    visibility = ["//visibility:public"],
)
